# ===== ROLES =====
role GIAdmin   rank 100
role ClubAdmin rank 60
role Viewer    rank 10

# ===== USERS =====
user gi_root      as GIAdmin
user club1_admin  as ClubAdmin
user viewer_joe   as Viewer

# ===== RESOURCES (RN -> owner) =====
# Club 1 hierarchy owned by club1_admin
resource rn::club:1 owner club1_admin
resource rn::club:1::member:101 owner club1_admin
resource rn::club:1::member:101::safeguarding:1 owner club1_admin
resource rn::club:1::discipline:1 owner club1_admin
resource rn::club:1::event:1 owner club1_admin
resource rn::club:1::event:1::competition:1 owner club1_admin
resource rn::club:1::event:1::competition:1::category:1 owner club1_admin
resource rn::club:1::event:1::competition:1::entry:1 owner club1_admin

# Club 2 (no special owner perms in this demo)
resource rn::club:2 owner gi_root

# ===== RESOURCE-LEVEL POLICIES =====
# GIAdmin can do everything
allow manage on rn::* to GIAdmin

# ClubAdmin: manage members & their safeguarding (or owner)
allow manage on rn::club:*::member:*,rn::club:*::member:*::safeguarding:* to ClubAdmin or owner

# ClubAdmin: read-only across wider club structure (or owner)
allow read on rn::club:*::discipline:*,
               rn::club:*::event:*,
               rn::club:*::event:*::competition:*,
               rn::club:*::event:*::competition:*::category:*,
               rn::club:*::event:*::competition:*::entry:* to ClubAdmin or owner

# Explicitly block ClubAdmin from editing non-member areas (defensive)
deny  edit   on rn::club:*::discipline:*,
               rn::club:*::event:*,
               rn::club:*::event:*::competition:*,
               rn::club:*::event:*::competition:*::category:*,
               rn::club:*::event:*::competition:*::entry:* to ClubAdmin

# Viewer: read-only everywhere (no owner override)
allow read on rn::* to Viewer

# ===== FIELD-LEVEL POLICIES =====
# GIAdmin sees all fields on these models anywhere
allow read  fields * of Member              on rn::* to GIAdmin
allow read  fields * of Safeguarding        on rn::* to GIAdmin
allow read  fields * of Competition         on rn::* to GIAdmin
allow read  fields * of CompetitionCategory on rn::* to GIAdmin
allow read  fields * of Entry               on rn::* to GIAdmin

# ClubAdmin: can read common member fields at their clubs; hide sensitive ones
allow read  fields name,email,phone,status,dob of Member on rn::club:* to ClubAdmin
deny  read  fields ssn,national_id,medical_notes of Member on rn::club:* to ClubAdmin
# ClubAdmin: can update basic profile fields
allow write fields name,email,phone,status of Member on rn::club:* to ClubAdmin

# Owner-only example for fields: owner of a competition can read private_notes
allow read fields private_notes of Competition on rn::club:*::event:*::competition:* to Viewer or owner
